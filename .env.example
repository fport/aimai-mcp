# Bearer tokens are static here on purpose: the project is about what the
# server does with an identity, not about how the identity was minted.
# Rotate these before pointing anything real at the servers.
AIMAI_MCP_TOKENS=tok-acme-analyst:acme:analyst,tok-acme-admin:acme:admin,tok-globex-analyst:globex:analyst

# Where the seeded support database lives. The reader opens it read-only
# through a `file:...?mode=ro` URI; the writer opens the same file read-write.
AIMAI_MCP_DB=data/support.sqlite3

# Reader and writer are the same package started with different tool sets.
AIMAI_MCP_ROLE=reader

# The agent talks to both over HTTP. stdio exists for development only: on
# stdio the identity is the process environment, so there is no multi-tenancy.
AIMAI_MCP_READER_URL=http://localhost:8811/mcp
AIMAI_MCP_WRITER_URL=http://localhost:8812/mcp
AIMAI_MCP_TOKEN=tok-acme-analyst

# Domains `fetch_url` is allowed to reach. Everything else is refused before
# the request leaves the process.
AIMAI_MCP_FETCH_ALLOWLIST=status.example.com,docs.example.com
